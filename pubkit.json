{
  "kind": "service",
  "ci": {
    "with": {
      "setup": "python -m pip install --quiet uv==0.12.18 && uv venv -q .venv && uv pip install -q --python .venv --require-hashes -r tests/requirements.lock",
      "test": ".venv/bin/python -m pytest -q tests",
      "shellcheck": "with-secrets"
    }
  },
  "protect": {
    "checks": [
      "ci / passed",
      "integrations / scan"
    ],
    "tags": false
  },
  "secrets": [
    {
      "from": "sustenaut-deploy-ssh-key",
      "to": "SUSTENAUT_DEPLOY_SSH_KEY",
      "kind": "secret"
    },
    {
      "from": "TS_GH_OAUTH_CLIENT_ID",
      "to": "TS_GH_OAUTH_CLIENT_ID",
      "kind": "secret"
    },
    {
      "from": "TS_GH_OAUTH_SECRET",
      "to": "TS_GH_OAUTH_SECRET",
      "kind": "secret"
    },
    {
      "from": "sustenaut-server",
      "to": "SUSTENAUT_SERVER",
      "kind": "variable"
    },
    {
      "from": "sustenaut-known-hosts",
      "to": "SUSTENAUT_KNOWN_HOSTS",
      "kind": "variable"
    }
  ],
  "deploy": {
    "providers": [{"distribution": "pubdeploy", "wheel": "https://github.com/Sustenaut/pubdeploy/releases/download/v0.4.1/pubdeploy-0.4.1-py3-none-any.whl", "sha256": "c9c9b49b44b771c6f15219c186e3646203381c6a30570c0b2568951d3a53deb0"}, {"distribution": "pubsec", "wheel": "https://github.com/Sustenaut/pubsec/releases/download/v0.2.3/pubsec-0.2.3-py3-none-any.whl", "sha256": "4a0b9435ff111565265f330fa3a1642b59562d77b5d1806c1bfecfe83e63b106"}],
    "namespace": "review",
    "host": "review.sustenaut.eu",
    "workflow": "deploy.yml",
    "gate": "DEPLOY_REVIEW",
    "needs": [
      {
        "type": "gcp.workload-identity",
        "account": "sustenaut-review-site",
        "project": "sustenaut",
        "serviceaccount": "app",
        "pool": "projects/948171295184/locations/global/workloadIdentityPools/services",
        "granted_in": "Sustenaut/shared-infra's infra/services-identity.tf"
      },
      {
        "type": "bitwarden.secret",
        "name": "auth-review-client-secret",
        "secret": {
          "name": "review-secrets",
          "key": "keycloak-client-secret"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "review-session-secret",
        "secret": {
          "name": "review-secrets",
          "key": "session-secret"
        }
      },
      {
        "type": "bitwarden.generated",
        "name": "review-cookie-secret",
        "shape": "oauth2-proxy-cookie",
        "secret": {
          "name": "review-cookie",
          "key": "cookie-secret"
        }
      },
      {
        "type": "auth.sign-in-client",
        "realm": "team",
        "role": "review",
        "auth": "https://auth.sustenaut.eu/realms/team",
        "domain": "sustenaut.eu",
        "host": "review.sustenaut.eu",
        "state": "/root/.config/sustenaut-auth/team-sustenaut.eu",
        "client_name": "sustenaut.eu team sites",
        "register_app": "../auth/register-app.py",
        "approvals": "../shared-infra/infra/auth-approvals.json",
        "access": "https://auth.sustenaut.eu/realms/team/access",
        "secret": {
          "name": "review-oidc"
        }
      },
      {
        "type": "k8s.manifests",
        "path": "k8s/admin/network-policy.yaml"
      }
    ]
  },
  "mirror": {
    "wheels": "https://storage.sustenaut.eu/wheels",
    "terraform": "https://storage.sustenaut.eu/terraform",
    "pypi": "https://storage.sustenaut.eu/pypi"
  }
}
